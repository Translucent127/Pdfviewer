<Window x:Class="PDF_COPY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF COPY v1.3.0" Height="750" Width="1240"
        Background="#1E1E1E" WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Style Button Toolbar Header -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style Auto Copy Box -->
        <Style x:Key="HeaderBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Style Side Panel Tab Switcher Buttons -->
        <Style x:Key="TabSwitchButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Toolbar -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnOpenPdf" Content="Open PDF" Style="{StaticResource HeaderButtonStyle}" Click="BtnOpenPdf_Click"/>
                    <Button Name="BtnResetPdf" Content="Reset" Style="{StaticResource HeaderButtonStyle}" Margin="6,0,0,0" Click="BtnResetPdf_Click"/>
                    <TextBlock Name="TxtFileName" Text="" Foreground="#8E8E8E" 
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Name="BtnToggleSku" Content="Side Panel" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0" Click="BtnToggleSku_Click"/>
                    <Border Style="{StaticResource HeaderBoxStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Auto Copy:" Foreground="#F1F1F1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <CheckBox Name="ChkAutoCopy" IsChecked="True" Content="Enabled" Foreground="#22C55E" 
                                      VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- PDF Viewer & Main Toast -->
            <Grid Grid.Column="0">
                <wv2:WebView2 Name="PdfWebViewer"/>

                <Border Name="PlaceholderPanel" Background="#1E1E1E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.8"/>
                        <TextBlock Text="Select a PDF File to Get Started" Foreground="#E0E0E0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Highlight text to copy it automatically" Foreground="#777777" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Toast Notification PDF Copy -->
                <Border Name="ToastNotification" 
                        Background="#252525" BorderBrush="#22C55E" BorderThickness="1.5" CornerRadius="8" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,24,0" Padding="12,8" 
                        Visibility="Collapsed" Panel.ZIndex="999">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#22C55E" Margin="0,0,8,0">
                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Text Copied Successfully!" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Name="TxtToastContent" Text="" Foreground="#D0D0D0" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT SIDE PANEL (SKU Summary + Log) -->
            <Border Name="PanelSkuRecap" Grid.Column="1" Width="350" Visibility="Collapsed"
                    Background="#222222" BorderBrush="#333333" BorderThickness="1,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Segmented Tab Switcher & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tab Buttons -->
                        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="6" Padding="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Name="BtnTabSku" Grid.Column="0" Content="📦 SKU Summary" Style="{StaticResource TabSwitchButtonStyle}" Click="BtnTabSku_Click"/>
                                <Button Name="BtnTabNotes" Grid.Column="1" Content="📝 Log" Style="{StaticResource TabSwitchButtonStyle}" Click="BtnTabNotes_Click"/>
                            </Grid>
                        </Border>

                        <Button Grid.Column="1" Content="✕" Width="22" Height="22" Margin="8,0,0,0" Background="Transparent" 
                                Foreground="#888888" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnToggleSku_Click"/>
                    </Grid>

                    <!-- TAB 1 CONTENT: SKU SUMMARY -->
                    <Grid Name="GridSkuContent" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Input SKU -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Name="TxtSkuInput" Height="30" Padding="8,4" Background="#1A1A1A" Foreground="#FFFFFF" 
                                     BorderBrush="#444444" BorderThickness="1" FontSize="12" VerticalAlignment="Center"
                                     CharacterCasing="Upper" KeyDown="TxtSkuInput_KeyDown">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="1" Content="+ Add" Height="30" Padding="10,0" Margin="6,0,0,0"
                                    Background="#0066FF" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold"
                                    FontSize="12" Cursor="Hand" Click="BtnAddSku_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <!-- SKU List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="LstSkuItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Margin="0,0,0,8" Padding="10,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2A2A2A"/>
                                                    <Setter Property="BorderBrush" Value="#383838"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                            <Setter Property="Background" Value="#7F1D1D"/>
                                                            <Setter Property="BorderBrush" Value="#EF4444"/>
                                                            <Setter Property="BorderThickness" Value="2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F1F1F1" FontSize="12" 
                                                           VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                    <Button Content="-" Width="24" Height="24" Background="#383838" Foreground="#FFFFFF" 
                                                            BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnDecrement_Click" Tag="{Binding}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" 
                                                             Foreground="#22C55E" Background="#1A1A1A" BorderBrush="#444444" BorderThickness="1"
                                                             FontWeight="Bold" FontSize="12" Width="40" Height="24" TextAlignment="Center" 
                                                             VerticalAlignment="Center" Margin="4,0" PreviewTextInput="NumberValidationTextBox">
                                                        <TextBox.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </TextBox.Resources>
                                                    </TextBox>

                                                    <Button Content="+" Width="24" Height="24" Background="#383838" Foreground="#FFFFFF" 
                                                            BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnIncrement_Click" Tag="{Binding}">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="3"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" 
                                                        Foreground="#EF4444" BorderThickness="0" FontWeight="Bold" FontSize="11" 
                                                        Cursor="Hand" Click="BtnDeleteSku_Click" Tag="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- SKU Action Buttons -->
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <!-- Toast In-Panel SKU -->
                            <Border Name="SkuToastNotification" Background="#252525" BorderBrush="#22C55E" BorderThickness="1.5" 
                                    CornerRadius="6" HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="10,6" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="18" Height="18" CornerRadius="9" Background="#22C55E" Margin="0,0,8,0">
                                        <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Name="TxtSkuToastContent" Text="" Foreground="#D0D0D0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Name="BtnExportSku" Content="📋 Copy SKU Summary" Height="34" Background="#22C55E" Foreground="#FFFFFF" 
                                    BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnExportSku_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Name="BtnResetQty" Content="🔄 Reset Quantities (Set to 0)" Height="28" Margin="0,6,0,0" Background="#333333" 
                                    Foreground="#A0A0A0" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnResetQty_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Name="BtnClearAllSku" Content="🗑️ Clear All SKUs" Height="28" Margin="0,6,0,0" Background="#333333" 
                                    Foreground="#EF4444" BorderThickness="0" FontSize="11" Cursor="Hand" Click="BtnClearAllSku_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- TAB 2 CONTENT: LOG -->
                    <Grid Name="GridNotesContent" Grid.Row="1" Visibility="Collapsed">
                        <TextBox Name="TxtScratchpad"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" 
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 Background="#1A1A1A" Foreground="#F1F1F1" BorderBrush="#444444" BorderThickness="1"
                                 Padding="10" FontSize="15" FontFamily="Constantia"
                                 TextChanged="TxtScratchpad_TextChanged"
                                 SelectionChanged="TxtScratchpad_SelectionChanged"
                                 KeyDown="TxtScratchpad_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>

                    <!-- In-App Overlays -->
                    <Border Name="ConfirmClearOverlay" Grid.RowSpan="2" Margin="-12" Background="#D9111111" Visibility="Collapsed" Panel.ZIndex="999">
                        <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="270" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Confirm Clear All SKUs" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Are you sure you want to clear all entered SKUs?" Foreground="#C0C0C0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Name="BtnConfirmClearYes" Grid.Column="0" Content="Yes" Height="30" Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnConfirmClearYes_Click"/>
                                    <Button Name="BtnConfirmClearNo" Grid.Column="2" Content="No" Height="30" Background="#333333" Foreground="#F1F1F1" BorderBrush="#444444" BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="BtnConfirmClearNo_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>

                    <Border Name="InfoExportOverlay" Grid.RowSpan="2" Margin="-12" Background="#D9111111" Visibility="Collapsed" Panel.ZIndex="999">
                        <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" CornerRadius="8" Padding="16" Width="270" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Information" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="There are no SKUs with a quantity greater than 0 to copy." Foreground="#C0C0C0" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                <Button Name="BtnInfoExportOk" Content="OK" Height="30" Background="#0066FF" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnInfoExportOk_Click"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
<Window x:Class="EdgePdfReaderPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PDF Viewer" Height="750" Width="1200"
        Background="#1E1E1E" WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Consistent Style for Header Buttons -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#555555"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#282828"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Consistent Style for Auto Copy Box -->
        <Style x:Key="HeaderBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Minimalist Header Toolbar -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Open PDF, Reset, & File Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnOpenPdf" Content="Open PDF" Style="{StaticResource HeaderButtonStyle}" Click="BtnOpenPdf_Click"/>

                    <Button Name="BtnResetPdf" Content="Reset" Style="{StaticResource HeaderButtonStyle}" Margin="6,0,0,0" Click="BtnResetPdf_Click"/>

                    <TextBlock Name="TxtFileName" Text="" Foreground="#8E8E8E" 
                               VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Right Feature Buttons (Toggle SKU Summary & Auto Copy) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- SKU Summary Button -->
                    <Button Name="BtnToggleSku" Content="SKU Summary" Style="{StaticResource HeaderButtonStyle}" Margin="0,0,6,0" Click="BtnToggleSku_Click"/>

                    <!-- Auto Copy Toggle -->
                    <Border Style="{StaticResource HeaderBoxStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Auto Copy:" Foreground="#F1F1F1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0"/>
                            <CheckBox Name="ChkAutoCopy" IsChecked="True" Content="Enabled" Foreground="#22C55E" 
                                      VerticalAlignment="Center" FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Area: Left (PDF Viewer) & Right (SKU Summary Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: PDF Viewer & Toast Notification -->
            <Grid Grid.Column="0">
                <wv2:WebView2 Name="PdfWebViewer"/>

                <!-- Placeholder When No PDF Is Opened -->
                <Border Name="PlaceholderPanel" Background="#1E1E1E" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" Opacity="0.8"/>
                        <TextBlock Text="Select a PDF File to Get Started" Foreground="#E0E0E0" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Highlight text to copy it automatically" Foreground="#777777" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Text Copied Notification Toast Pop-Up -->
                <Border Name="ToastNotification" 
                        Background="#252525" 
                        BorderBrush="#22C55E" 
                        BorderThickness="1.5" 
                        CornerRadius="8" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Top" 
                        Margin="0,16,24,0" 
                        Padding="12,8" 
                        Visibility="Collapsed"
                        Panel.ZIndex="999">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.5" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="10" Background="#22C55E" Margin="0,0,8,0">
                            <TextBlock Text="✓" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Text Copied Successfully!" Foreground="#22C55E" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Name="TxtToastContent" Text="" Foreground="#D0D0D0" FontSize="11" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN: SKU SUMMARY PANEL -->
            <Border Name="PanelSkuRecap" Grid.Column="1" Width="330" Visibility="Collapsed"
                    Background="#222222" BorderBrush="#333333" BorderThickness="1,0,0,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Title & Close Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="📦 SKU Summary" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Content="✕" Width="22" Height="22" HorizontalAlignment="Right" Background="Transparent" 
                                Foreground="#888888" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Click="BtnToggleSku_Click"/>
                    </Grid>

                    <!-- Manual SKU Input -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="TxtSkuInput" Height="30" Padding="8,4" Background="#1A1A1A" Foreground="#FFFFFF" 
                                 BorderBrush="#444444" BorderThickness="1" FontSize="12" VerticalAlignment="Center"
                                 CharacterCasing="Upper" KeyDown="TxtSkuInput_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <Button Grid.Column="1" Content="+ Add" Height="30" Padding="10,0" Margin="6,0,0,0"
                                Background="#0066FF" Foreground="#FFFFFF" BorderThickness="0" FontWeight="SemiBold"
                                FontSize="12" Cursor="Hand" Click="BtnAddSku_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- SKU List -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl Name="LstSkuItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Margin="0,0,0,8" Padding="10,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#2A2A2A"/>
                                                <Setter Property="BorderBrush" Value="#383838"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Background" Value="#7F1D1D"/>
                                                        <Setter Property="BorderBrush" Value="#EF4444"/>
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- SKU Name -->
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#F1F1F1" FontSize="12" 
                                                       VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>

                                            <!-- Qty Adjuster (+ / - / Manual Edit) -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <Button Content="-" Width="24" Height="24" Background="#383838" Foreground="#FFFFFF" 
                                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                                        Click="BtnDecrement_Click" Tag="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- Qty Textbox -->
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" 
                                                         Foreground="#22C55E" Background="#1A1A1A" BorderBrush="#444444" BorderThickness="1"
                                                         FontWeight="Bold" FontSize="12" Width="40" Height="24" TextAlignment="Center" 
                                                         VerticalAlignment="Center" Margin="4,0" PreviewTextInput="NumberValidationTextBox">
                                                    <TextBox.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </TextBox.Resources>
                                                </TextBox>

                                                <Button Content="+" Width="24" Height="24" Background="#383838" Foreground="#FFFFFF" 
                                                        BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                                        Click="BtnIncrement_Click" Tag="{Binding}">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="3"/>
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </StackPanel>

                                            <!-- Delete Item Button -->
                                            <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" 
                                                    Foreground="#EF4444" BorderThickness="0" FontWeight="Bold" FontSize="11" 
                                                    Cursor="Hand" Click="BtnDeleteSku_Click" Tag="{Binding}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <Button Name="BtnExportSku" Content="📋 Copy SKU Summary" Height="34" 
                                Background="#22C55E" Foreground="#FFFFFF" BorderThickness="0" 
                                FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnExportSku_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Name="BtnResetQty" Content="🔄 Reset Quantities (Set to 0)" Height="28" Margin="0,6,0,0"
                                Background="#333333" Foreground="#A0A0A0" BorderThickness="0" 
                                FontSize="11" Cursor="Hand" Click="BtnResetQty_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Name="BtnClearAllSku" Content="🗑️ Clear All SKUs" Height="28" Margin="0,6,0,0"
                                Background="#333333" Foreground="#EF4444" BorderThickness="0" 
                                FontSize="11" Cursor="Hand" Click="BtnClearAllSku_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- In-App Confirmation Pop-Up Overlay -->
                    <Border Name="ConfirmClearOverlay" Grid.RowSpan="4" Margin="-12" 
                            Background="#D9111111" Visibility="Collapsed" Panel.ZIndex="999">
                        <Border Background="#252525" BorderBrush="#444444" BorderThickness="1" 
                                CornerRadius="8" Padding="16" Width="270" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" Color="Black" Opacity="0.6" ShadowDepth="4"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="Confirm Clear All SKUs" Foreground="#FFFFFF" FontWeight="Bold" 
                                           FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Are you sure you want to clear all entered SKUs?" Foreground="#C0C0C0" 
                                           FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Name="BtnConfirmClearYes" Grid.Column="0" Content="Yes" Height="30" 
                                            Background="#EF4444" Foreground="#FFFFFF" BorderThickness="0" 
                                            FontWeight="Bold" FontSize="12" Cursor="Hand" Click="BtnConfirmClearYes_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>

                                    <Button Name="BtnConfirmClearNo" Grid.Column="2" Content="No" Height="30" 
                                            Background="#333333" Foreground="#F1F1F1" BorderBrush="#444444" 
                                            BorderThickness="1" FontWeight="SemiBold" FontSize="12" Cursor="Hand" Click="BtnConfirmClearNo_Click">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>